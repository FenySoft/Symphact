<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Symphact.Platform.Cfpu</RootNamespace>
    <AssemblyName>Symphact.Platform.Cfpu</AssemblyName>
    <Description>CFPU hardware platform bridge for the Symphact actor runtime. Connects to the CLI-CPU golden reference simulator (CilCpu.Sim) for hardware-fidelity integration testing.</Description>
    <PackageId>FenySoft.Symphact.Platform.Cfpu</PackageId>
    <PackageTags>actor;runtime;symphact;platform;cfpu;simulator</PackageTags>
    <!-- hu: A CFPU-híd stub (a CLI-CPU F4 multi-core-ra vár) — nem adható ki NuGet-en.
             A nuget.org-on a verziószám nem törölhető és nem használható újra, ezért a kizárást
             a projekt maga rögzíti, nem a kiadó emlékezete.
         en: The CFPU bridge is a stub (awaiting CLI-CPU F4 multi-core) — it must not ship on NuGet.
             A nuget.org version number can neither be deleted nor reused, so the exclusion is pinned
             in the project itself rather than left to the publisher's memory. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Symphact.Core\Symphact.Core.csproj" />
  </ItemGroup>

</Project>
